<!-- isSetFlag() would be renamed to getSetFlag(), clashing with the getter of setFlag -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
    xmlns:tns="http://cxf.apache.org/configuration/foo2" targetNamespace="http://cxf.apache.org/configuration/foo2"
    elementFormDefault="qualified" jaxb:version="3.0">

    <xs:annotation>
        <xs:appinfo>
            <jaxb:globalBindings generateIsSetMethod="true"/>
        </xs:appinfo>
    </xs:annotation>

    <xs:element name="toggle" type="tns:toggle"/>

    <xs:complexType name="toggle">
        <xs:sequence>
            <xs:element name="flag" type="xs:boolean" minOccurs="0"/>
            <xs:element name="setFlag" type="xs:string" minOccurs="0"/>
            <!-- getter is is1St() -->
            <xs:element name="_1st" type="xs:boolean" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>
